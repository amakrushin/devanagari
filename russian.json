        {
            "id": "signs",
            "label": "Signs and rare letters",
            "audio": true,
            "chars": [
                {"glyph": "Й й", "roman": "य", "slug": "yot", "tts": "и краткое", "note": "short y after a vowel: ай reads like the end of आइ"},
                {"glyph": "Ж ж", "roman": "ज", "slug": "zh", "tts": "жэ", "note": "voiced ш, like the s in English 'measure'"},
                {"glyph": "Ц ц", "roman": "त्स", "slug": "ts", "tts": "цэ", "note": "t and s said together, like the ts in बत्स"},
                {"glyph": "Щ щ", "roman": "श्श", "slug": "shch", "tts": "ща", "note": "long soft श, said with a smile"},
                {"glyph": "ь", "roman": "नरम", "slug": "soft", "tts": "мягкий знак", "note": "soft sign: no sound of its own; softens the consonant before it, like a hint of य"},
                {"glyph": "ъ", "roman": "कडा", "slug": "hard", "tts": "твёрдый знак", "note": "hard sign: no sound; keeps the consonant before it hard and separates it from the vowel"}
            ]
        },
