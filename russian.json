            "id": "vowels",
            "label": "Vowels",
            "audio": true,
            "chars": [
                {"glyph": "А а", "roman": "अ", "slug": "a", "tts": "а"},
                {"glyph": "О о", "roman": "ओ", "slug": "o", "tts": "о"},
                {"glyph": "У у", "roman": "उ", "slug": "u", "tts": "у"},
                {"glyph": "Э э", "roman": "ए", "slug": "e", "tts": "э", "note": "open e, as in English 'end'"},
                {"glyph": "Ы ы", "roman": "इ", "slug": "y", "tts": "ы", "note": "no Nepali match: say इ with the tongue pulled back; never starts a word"},
                {"glyph": "И и", "roman": "ई", "slug": "i", "tts": "и"},
                {"glyph": "Е е", "roman": "ये", "slug": "ye", "tts": "е", "note": "ये at the start of a word; after a consonant just े with the consonant softened"},
                {"glyph": "Ё ё", "roman": "यो", "slug": "yo", "tts": "ё", "note": "always stressed; print often writes it as е"},
                {"glyph": "Ю ю", "roman": "यु", "slug": "yu", "tts": "ю"},
                {"glyph": "Я я", "roman": "या", "slug": "ya", "tts": "я"}
            ]
        },
